{% assign collectionIndexes = 0 | plus: 0 %}

<section class="section-index-gift">
  <div class="comp-section-img">
    <div class="img_wrap">
      <img class="sp_img" src="{{ 'index_img02.jpg' | asset_url }}">
      <img class="pc_img" src="{{ 'index_img02_pc.jpg' | asset_url }}">
    </div>
  </div><!-- comp-section-img -->
  <div class="section_inner">
    <div class="product_wrapper">
      <div class="comp-product-list">
        <div class="list_ttl_flex">
          <h2 class="list_ttl">Gift</h2>
          <div class="comp-button-wrap">
            <a href="/collections/gift">
              <span class="txt">All</span>
              <span class="caret">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5.76 10" style="fill:#fff;">
                  <path class="cls-1" d="m4.07,5L.25,8.81c-.08.08-.08.17-.17.25,0,.08-.08.17-.08.25s0,.17.08.25c0,.08.08.17.17.25.17.08.34.17.51.17s.34-.08.51-.17l4.32-4.32c.08-.17.17-.34.17-.51s-.08-.34-.17-.51L1.27.17c-.17-.08-.34-.17-.51-.17S.42.08.25.17s-.17.34-.25.51c0,.17.08.34.17.51l3.9,3.81Z">
                </path>
                </svg>
              </span>
            </a>
          </div>
        </div><!-- list_ttl_flex -->
        <div class="list_contents_flex">
        {% for collection in collections %}
          {%- if collection.handle == 'gift' -%}
            {% for product in collection.products %}
              {% for product in collection.products %}
                {%- if collectionIndexes < 4 -%}
                  {%- include 'all-item-card' -%}
                {%- endif -%}
                  {% assign collectionIndexes = collectionIndexes | plus: 1 %}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        </div><!-- list_contents_flex -->
      </div><!-- comp-product-list -->
    </div><!-- product_wrapper -->
  </div><!-- section_inner -->
</section>
