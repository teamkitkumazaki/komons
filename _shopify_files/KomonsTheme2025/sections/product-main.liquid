{%- assign thumbIndexNum = 0 -%}
{% for image in product.images %}
  {%- assign thumbIndexNum = thumbIndexNum | plus: 1 -%}
{% endfor %}
<section class="section-product-detail">
  <div class="section_wide">
    <div class="flex_wrap">
      <div class="img_wrap sticky">
        <div id="prodImages" class="comp-product-images">
          <div id="thumbBox" class="thumb_img">
            {{ product.media[0] | image_url: width: 1200 | image_tag:class:'thumbs' }}
          </div>
          <div id="thumbnails" class="thumbnails" style="--thumbItem: {{ imgLength }};">
            <div class="thumb_inner">
              {% for image in product.images %}
              <div class="thumb_item">
                <button {% if forloop.index == 1 %}class="active_thumb"{% endif %}>
                  {{ image.src | image_url: width: 1200 | image_tag }}
                </button>
              </div>
              {% endfor %}
            </div>
          </div><!-- thumbnails -->
        </div><!-- comp-product-images -->
      </div>
      <div class="detail_wrap">
        <div class="comp-page-bread">
          <div class="link_wrap">
            <a href="/" class="pjax">ホーム</a>
            {% if product.type contains 'gift' %}
            <a href="/collections/all-products" class="pjax">通常商品一覧</a>
            {% else %}
            <a href="/collections/gift" class="pjax">ギフト商品一覧</a>
            {% endif %}
            <span class="current">{{ product.title }}</span>
          </div>
        </div>
        <div class="name_wrap">
          <h1 class="prod_ttl">
            <span class="ttl_jp">{{ product.metafields.custom_fields["prod_category"] }}</span>
            <span class="ttl_en">{{ product.metafields.custom_fields["prod_display_name"] }}</span>
          </h1>
          <div class="prod_price">
            <span class="price">{{ product.price | money_without_currency }}円(税込)</span>
            <span class="volume">/ {% if product.metafields.custom_fields["prod_volume"] != blank %}{{ product.metafields.custom_fields["prod_volume"] }}{%- else -%}セット商品{% endif %}</span>
          </div>
        </div>
        <div class="detail_upper">
          <div class="description">
            <p>{{ product.metafields.custom_fields["prod_description"] }}</p>
          </div>
        </div>
        {% include 'product-variation-select' %}
        {% include 'product-gift-options' %}
        {% include 'product-cart-wrap-sub' %}
        {% include 'product-brand-introduction' %}
        {% include 'product-detail-desc' %}
        {% include 'product-scent-detail' %}
        {% include 'product-detail-toggle' %}
      </div><!-- detail_wrap -->
    </div><!-- flex_wrap -->
  </div><!-- section_wide -->
</section>
