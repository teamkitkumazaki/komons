{% assign collectionIndex = 0 | plus: 0 %}

{% if product.tags contains 'kitchen' %}
  {% assign relatedHandle = 'kitchen' %}
  {% assign relatedTtl = 'キッチン用品' %}
{% endif %}

{% if product.tags contains 'toilet-bath' %}
  {% assign relatedHandle = 'toilet' %}
  {% assign relatedTtl = 'トイレ/バスルーム' %}
{% endif %}

{% if product.tags contains 'living' %}
  {% assign relatedHandle = 'living' %}
  {% assign relatedTtl = 'リビング/寝室' %}
{% endif %}

{% if product.tags contains 'others' %}
  {% assign relatedHandle = 'others' %}
  {% assign relatedTtl = 'その他の商品' %}
{% endif %}

{% if product.type == 'gift' %}
  {% assign relatedHandle = 'gift' %}
  {% assign relatedTtl = 'ギフト商品一覧' %}
{% endif %}

{% if relatedHandle != blank %}
<section class="section-product-recomend01">
  <div class="section_inner">
    <div class="comp-product-list">
      <div class="list_ttl_flex">
      <div class="comp-detail-title" style="margin-bottom: 0;">
        <hgroup>
          <span class="title_en">Related Items</span>
          <h2 class="title_ja">{{ relatedTtl }}</h2>
        </hgroup>
      </div>
        <div class="comp-button-wrap">
          <a href="/collections/{{ relatedHandle }}">
            <span class="txt">All</span>
            <span class="caret">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5.76 10" style="fill:#fff;">
                <path class="cls-1"
                  d="m4.07,5L.25,8.81c-.08.08-.08.17-.17.25,0,.08-.08.17-.08.25s0,.17.08.25c0,.08.08.17.17.25.17.08.34.17.51.17s.34-.08.51-.17l4.32-4.32c.08-.17.17-.34.17-.51s-.08-.34-.17-.51L1.27.17c-.17-.08-.34-.17-.51-.17S.42.08.25.17s-.17.34-.25.51c0,.17.08.34.17.51l3.9,3.81Z">
                </path>
              </svg>
            </span>
          </a>
        </div>
      </div><!-- list_ttl_flex -->
      <div class="list_contents_flex">
      {% for collection in collections %}
        {%- if collection.handle == relatedHandle -%}
          {% for product in collection.products %}
            {% for product in collection.products %}
              {%- if collectionIndex < 8 -%}
                {%- include 'all-item-card' -%}
              {%- endif -%}
                {% assign collectionIndex = collectionIndex | plus: 1 %}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      </div><!-- list_contents_flex -->
    </div>
  </div><!-- section_inner -->
</section>
  {% endif %}
