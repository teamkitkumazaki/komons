{%- assign fukubukuLength = 0 | plus : 0 -%}
{%- for item in cart.items -%}
  {% if item.product.type == 'fukubukuro'  %}
    {%- assign fukubukuLength = fukubukuLength | plus : 1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="comp-admin-subttl">
  <h2 class="ttl">お届け希望日時</h2>
</div>
<div class="comp-admin-form">
  <div class="form_item">
    <label class="large ">お届け希望日程</label>
    <div class="form_wrap">
      {%- if fukubukuLength == 0  -%}
      {% include 'cart-side-wrap-date-box' %}
      {%- else -%}
      <select id="deliveryDateBox">
        <option value="指定なし">1月5日(金)以降に随時配送</option>
      </select>
      <input id="dateInput" type="hidden" name="attributes[配送予定日:]" value="指定なし">
      <p class="example">※福袋商品を含むご注文の配送日時指定は出来ません。</p>
      {%- endif -%}
    </div>
  </div>
  <div class="form_item">
    <label class="large ">お届け希望時間</label>
    <div class="form_wrap">
      <select id="deliveryTime" name="attributes[配送時間帯:]">
        <option value="指定なし" selected="">指定なし</option>
        <option value="午前中（12時まで）">午前中（12時まで）</option>
        <option value="14時から16時">14時から16時</option>
        <option value="16時から18時">16時から18時</option>
        <option value="18時から20時">18時から20時</option>
        <option value="19時から21時">19時から21時</option>
      </select>
    </div>
  </div>
  <div class="form_item">
    <label class="large">配送方法の指定</label>
    <div class="form_wrap">
      <div id="deliveryOptions" class="delivery_options">
        <div class="option_item">
        <label class="active_label">
          <div class="input_wrap">
            <input type="radio" name="delivery_method" value="指定無し" checked>
            <span class="radio_checker"></span>
            <div class="option_name_wrap">
              <div class="option_name">指定無し</div>
            </div>
          </div>
        </label>
      </div>
        <div class="option_item">
        <label>
          <div class="input_wrap">
            <input type="radio" name="delivery_method" value="置き配">
            <span class="radio_checker"></span>
            <div class="option_name_wrap">
              <div class="option_name">置き配希望</div>
            </div>
          </div>
        </label>
      </div>
        <div class="option_item">
        <label>
          <div class="input_wrap">
            <input type="radio" name="delivery_method" value="宅配ボックス">
            <span class="radio_checker"></span>
            <div class="option_name_wrap">
              <div class="option_name">宅配ボックス希望</div>
            </div>
          </div>
        </label>
      </div>
      </div>
      <input id="methodInput" type="hidden" name="attributes[配送方法の指定:]" value="指定無し">
      <p class="example">ご購入手続き画面で[代引き決済]を選択されると場合配送方法の指定は無効となります。</p>
    </div>
  </div>
  {%- comment -%}
  <div class="form_item">
    <label class="large ">備考欄</label>
    <div class="form_wrap">
      <textarea name="note" id="CartSpecialInstructions" class="cart-note__input"></textarea>
      <p class="example">1注文につき、お届け先は1件のみとなります。<br>2件以上のお届け先をご希望の場合は別々にご注文ください。</p>
    </div>
  </div>
  {%- endcomment -%}
</div><!-- comp-admin-form -->
<div class="comp-amount-wrap">
  {% include 'cart-amount-price' %}
</div><!-- comp-amount-wrap -->
<div class="comp-admin-button mt">
  <input type="submit" name="checkout" class="checkout_button" value="ご購入手続きへ">
</div>
