<div class="list_item" price="{{ product.price | money_without_currency }}" category="{{ product.metafields["custom_fields"]["gift_category"] }}">
	<a href="{{ product.url }}">
		<span class="img_wrap">
			<img loading="lazy" src="{{ product.media[0] | image_url: width: 533 }}" srcset="{{ product.media[0] | image_url: width: 533 }} 1440w, {{ product.media[0] | image_url: width: 360 }} 768w, {{ product.media[0] | image_url: width: 533 }} 2048w" alt="{{ product.metafields.custom_fields["prod_display_name"] | strip_html }}">
		</span>
		<span class="txt_wrap">
			<span class="name_en">{{ product.metafields.custom_fields["prod_display_name"] }}</span>
			<span class="price">{{ product.price | money_without_currency }}円(税込)</span>
		</span>
	</a>
</div>
