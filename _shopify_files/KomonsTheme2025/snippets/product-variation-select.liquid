
{% if product.metafields["custom_fields"]["related_variation"] != blank %}
<div class="comp-variation-select">
  <span class="label">バリエーション</span>
  <select name="variation_select" onchange="location.href=value;">
    {% for item in product.metafields["custom_fields"]["related_variation"] %}
    {% if product.handle == item["product_handle"] %}
    <option selected= value="/products/{{ item["product_handle"] }}">{{ item["variation_ttl"] }}</option>
    {% else %}
    <option value="/products/{{ item["product_handle"] }}">{{ item["variation_ttl"] }}</option>
    {% endif %}
    {% endfor %}
  </select>
</div><!-- comp-variation-select -->
{% endif %}
